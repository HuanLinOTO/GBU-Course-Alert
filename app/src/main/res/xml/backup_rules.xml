<?xml version="1.0" encoding="utf-8"?>
<!-- 隐私约定：凭据/课表数据仅存本机，Android 12 以下云备份同样排除全部数据 -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
